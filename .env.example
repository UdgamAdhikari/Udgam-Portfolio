# ─────────────────────────────────────────────────────────────────────────────
# Server configuration. Copy to .env.local for development; set the same keys
# in your host's environment settings for production. None of these are sent
# to the browser except NEXT_PUBLIC_* values.
#
# NOTE: Next.js expands $VARS in env files. Escape every "$" in
# ADMIN_PASSWORD_HASH as "\$" when you put it in a file.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL. Locally, `npm run db:local` serves PGlite at this address.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5544/postgres
# Connections per server instance (keep 1 for PGlite; 5–10 for real Postgres,
# or use your provider's pooled URL on serverless).
DATABASE_POOL_MAX=5

# 32+ random characters. Signs form tokens, keys IP hashing and the analytics
# salt. Generate with: openssl rand -base64 48
APP_SECRET=

# The only account. Generate the hash with `npm run admin:hash`.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=

# ── Contact form email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend.
CONTACT_FROM_EMAIL="Portfolio <hello@your-domain.com>"
# Where inquiry notifications go.
CONTACT_TO_EMAIL=you@example.com
# Send visitors a short "received" email (contains none of their text;
# at most one per address per day).
CONTACT_SEND_CONFIRMATION=false

# ── Optional: Cloudflare Turnstile (extra bot check on the contact form) ────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Uploads ──────────────────────────────────────────────────────────────────
# "db" stores uploads in Postgres (served from /media/<id>).
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=db
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Maintenance (GET /api/cron/maintenance with Authorization: Bearer …) ────
CRON_SECRET=
# Archived inquiries are deleted after this many days.
INQUIRY_RETENTION_DAYS=730
ANALYTICS_RETENTION_DAYS=400
