    "image-size": "^2.1.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "simple-icons": "^16.37.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
